// ./.vscode/tasks.json
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-rust",
            "command": "cargo",
            "args": [
                "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}/grust"
            }
        }
    ]
}
